# Kopieren nach .env und anpassen.

# ist = Zahlungseingang zählt (Standard), soll = Rechnungsdatum zählt
VERSTEUERUNG=ist
# true, wenn eine Dauerfristverlängerung besteht (Frist + 1 Monat)
DAUERFRISTVERLAENGERUNG=false
# Bundesland des Finanzamts, für Feiertage (BW, BY, BE, BB, HB, HH, HE, MV, NI, NW, RP, SL, SN, ST, SH, TH)
BUNDESLAND=NW
# eigene USt-IdNr., damit sie auf Rechnungen nicht als Partner erkannt wird
EIGENE_USTID=DE123456789

# Verzeichnis mit den Unterordnern ausgang/ und eingang/
RECHNUNGS_VERZEICHNIS=/rechnungen

# Paperless-ngx (Token unter Profil > API-Token)
PAPERLESS_URL=
PAPERLESS_TOKEN=
PAPERLESS_TAGS_AUSGANG=Ausgangsrechnung
PAPERLESS_TAGS_EINGANG=Eingangsrechnung
# optionale benutzerdefinierte Felder in Paperless
PAPERLESS_FELD_NETTO=Netto
PAPERLESS_FELD_BRUTTO=Brutto
PAPERLESS_FELD_STEUER=Umsatzsteuer
PAPERLESS_FELD_STEUERSATZ=Steuersatz
PAPERLESS_FELD_ZAHLUNGSDATUM=Zahlungsdatum
# Tags für Kontoauszug und ELSTER-Übertragungsprotokoll im Monats-ZIP für die Steuerberatung
PAPERLESS_TAG_KONTOAUSZUG=Kontoauszug
PAPERLESS_TAG_PROTOKOLL=UStVA-Protokoll

# Kontoumsätze, die keinen Beleg brauchen (Teilwort in Partner oder Verwendungszweck, mit Komma getrennt)
BANK_IGNORIEREN=Finanzamt,Bundeskasse,Steuerverwaltung

# Monatsmittel der EZB-Kurse abrufen, wenn kein BMF-Kurs hinterlegt ist
EZB_KURSE=true

# Anmeldung für die Weboberfläche (dringend empfohlen, wenn die App im Netz erreichbar ist).
# Ein in der App unter "Einstellungen" geändertes Passwort hat Vorrang (python -m ustva passwort --zuruecksetzen).
APP_BENUTZER=
APP_PASSWORT=

DATENBANK=/data/finanzomat.sqlite
